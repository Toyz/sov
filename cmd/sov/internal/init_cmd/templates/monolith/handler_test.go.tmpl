package main

import (
	"testing"

	"github.com/Toyz/sov/rpc"
	"github.com/Toyz/sov/rpctest"
)

func TestEcho(t *testing.T) {
	eng := rpc.NewEngine()
	eng.Register(&EchoRouter{})

	var out EchoOut
	status, err := rpctest.CallInto(eng, rpctest.NewCtx(), "Echo", "echo", EchoIn{Message: "hi"}, &out)
	if err != nil {
		t.Fatalf("Echo.echo: %v", err)
	}
	if status != 200 {
		t.Fatalf("status = %d", status)
	}
	if out.Echo != "hi" {
		t.Fatalf("echo = %q, want %q", out.Echo, "hi")
	}
}
